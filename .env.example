# PulseStream — Environment Variables Reference
# Copy this file to .env and fill in your actual values.
# .env is gitignored — never commit real credentials.
#
# Usage with Docker Compose:
#   cp .env.example .env
#   # Edit .env with your values
#   docker compose up -d
#
# Usage with Spring Boot:
#   Export variables before running, or use your IDE's run configuration.

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pulsestream
POSTGRES_USER=pulsestream
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092
KAFKA_CONSUMER_GROUP=ps-activity-consumer
KAFKA_STREAMS_APP_ID=ps-streams-processor
KAFKA_TOPIC_ACTIVITY_EVENTS=user.activity.events
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_RETRIES=3
KAFKA_PUBLISH_TIMEOUT_MS=5000

# ─── Elasticsearch ───────────────────────────────────────────────────────────
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http
ELASTICSEARCH_PASSWORD=

# ─── Kibana ──────────────────────────────────────────────────────────────────
KIBANA_PORT=5601

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Application ─────────────────────────────────────────────────────────────
SERVER_PORT=8080
SESSION_TIMEOUT_MINUTES=30
